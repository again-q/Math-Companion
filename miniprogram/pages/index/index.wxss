/* ============================================================
   数学小伴 — 欢迎页样式
   ============================================================ */

.welcome-page {
  min-height: 100vh;
  background: var(--bg-primary);
  position: relative;
  padding: var(--space-2xl);
  padding-bottom: calc(var(--space-2xl) + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ============================================================
   顶部装饰
   ============================================================ */
.welcome-deco {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 400rpx;
  overflow: hidden;
  pointer-events: none;
}

.deco-circle {
  position: absolute;
  border-radius: 50%;
  background: var(--primary);
  opacity: 0.15;
}

.deco-circle-1 {
  width: 200rpx;
  height: 200rpx;
  top: 40rpx;
  left: -40rpx;
  animation: float 4s ease-in-out infinite;
}

.deco-circle-2 {
  width: 160rpx;
  height: 160rpx;
  top: 120rpx;
  right: -20rpx;
  animation: float 5s ease-in-out infinite;
  animation-delay: 1s;
}

.deco-circle-3 {
  width: 120rpx;
  height: 120rpx;
  top: 240rpx;
  left: 20%;
  animation: float 6s ease-in-out infinite;
  animation-delay: 2s;
}

/* ============================================================
   主视觉区域
   ============================================================ */
.welcome-main {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: calc(env(safe-area-inset-top) + 60rpx);
  animation: slideDown 0.6s ease;
}

.welcome-avatar {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-xl);
  box-shadow: 0 16rpx 56rpx var(--shadow-lg);
  animation: bounce 2s ease-in-out infinite;
}

.avatar-emoji {
  font-size: 100rpx;
}

.avatar-glow {
  position: absolute;
  top: -8rpx;
  left: -8rpx;
  right: -8rpx;
  bottom: -8rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  opacity: 0.4;
  filter: blur(20rpx);
  z-index: -1;
}

.welcome-title {
  font-size: 56rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}

.welcome-subtitle {
  font-size: var(--font-lg);
  color: var(--text-secondary);
  margin-bottom: var(--space-xl);
}

.welcome-desc {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  margin-bottom: var(--space-2xl);
}

.welcome-desc text {
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.6;
}

/* ============================================================
   特色功能卡片
   ============================================================ */
.features-section {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space);
  margin-bottom: var(--space-2xl);
  animation: slideUp 0.5s ease;
  animation-delay: 0.2s;
  animation-fill-mode: both;
}

.feature-card {
  background: var(--bg-card);
  border-radius: var(--radius-xl);
  padding: var(--space-xl);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: 0 4rpx 16rpx var(--shadow-sm);
  transition: all 0.3s ease;
}

.feature-card:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 8rpx var(--shadow-sm);
}

.feature-icon {
  width: 72rpx;
  height: 72rpx;
  background: var(--bg-primary);
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-sm);
}

.feature-icon text {
  font-size: 36rpx;
}

.feature-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.feature-desc {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  line-height: 1.5;
}

/* ============================================================
   操作按钮
   ============================================================ */
.welcome-actions {
  display: flex;
  flex-direction: column;
  gap: var(--space);
  animation: slideUp 0.5s ease;
  animation-delay: 0.3s;
  animation-fill-mode: both;
}

.btn-start {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 96rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  border-radius: var(--radius-full);
  box-shadow: 0 8rpx 32rpx var(--shadow);
}

.btn-start-icon {
  font-size: 36rpx;
}

.btn-start-label {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--text-on-primary);
}

.btn-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  background: var(--bg-card);
  border-radius: var(--radius-full);
  border: 2rpx solid rgba(255, 181, 194, 0.3);
}

.btn-secondary text {
  font-size: var(--font-lg);
  font-weight: 500;
  color: var(--text-secondary);
}

.btn-hover {
  opacity: 0.85;
  transform: scale(0.97);
}

/* ============================================================
   底部信息
   ============================================================ */
.welcome-footer {
  text-align: center;
  margin-top: 60rpx;
  animation: fadeIn 0.6s ease;
  animation-delay: 0.5s;
  animation-fill-mode: both;
}

.footer-text {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
  line-height: 1.8;
}

/* ============================================================
   动画
   ============================================================ */
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}

@keyframes slideDown {
  from { opacity: 0; transform: translateY(-30rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes slideUp {
  from { opacity: 0; transform: translateY(30rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}