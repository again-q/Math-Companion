<view class="summary-page">
  <view class="header">
    <view class="header-bg"></view>
    <view class="header-content">
      <view class="title-row">
        <text class="title">📊 学习总结</text>
        <text class="subtitle">记录你的每一次进步</text>
        <text class="update-time" wx:if="{{lastUpdatedText}}">上次更新：{{lastUpdatedText}}</text>
      </view>
      <button class="header-refresh-btn" bindtap="refreshSummary" loading="{{refreshing}}">刷新</button>
    </view>
  </view>

  <view class="content" wx:if="{{!loading}}">
    <view wx:if="{{empty}}" class="empty-state">
      <view class="empty-icon">📚</view>
      <text class="empty-title">还没有学习记录</text>
      <text class="empty-desc">快来开始你的数学之旅吧！</text>
      <button class="start-btn" bindtap="goToChat">开始学习</button>
    </view>

    <!-- 范围切换 -->
    <view class="scope-tabs" wx:if="{{!empty}}">
      <view class="scope-tab {{scope === 'recent' ? 'active' : ''}}" data-scope="recent" bindtap="switchScope">
        <text>📋 近期学习</text>
      </view>
      <view class="scope-tab {{scope === 'all' ? 'active' : ''}}" data-scope="all" bindtap="switchScope">
        <text>📊 全部历史</text>
      </view>
    </view>

    <view class="stats-grid" wx:if="{{!empty}}">
      <view class="stat-card">
        <text class="stat-value">{{learningDays}}</text>
        <text class="stat-label">学习天数</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">{{totalSessions}}</text>
        <text class="stat-label">学习次数</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">{{totalMessages}}</text>
        <text class="stat-label">对话消息</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">{{topicsCount}}</text>
        <text class="stat-label">知识点</text>
      </view>
    </view>

    <!-- 三个模块入口 -->
    <view class="entry-list" wx:if="{{!empty}}">
      <view class="entry-card" hover-class="btn-hover" bindtap="goKnowledge">
        <view class="entry-icon">
          <text>📈</text>
        </view>
        <view class="entry-info">
          <text class="entry-title">知识点掌握报告</text>
          <text class="entry-desc">{{knowledgeCount > 0 ? knowledgeCount + ' 个知识点，AI 逐点点评' : '查看每个知识点的掌握情况'}}</text>
        </view>
        <text class="entry-arrow">›</text>
      </view>

      <view class="entry-card" hover-class="btn-hover" bindtap="goSuggestions">
        <view class="entry-icon">
          <text>💡</text>
        </view>
        <view class="entry-info">
          <text class="entry-title">学习建议</text>
          <text class="entry-desc">{{suggestionsCount > 0 ? 'AI 为你定制的 ' + suggestionsCount + ' 条建议' : 'AI 定制专属学习建议'}}</text>
        </view>
        <text class="entry-arrow">›</text>
      </view>

      <view class="entry-card" hover-class="btn-hover" bindtap="goSummaryDetail">
        <view class="entry-icon">
          <text>🌟</text>
        </view>
        <view class="entry-info">
          <text class="entry-title">小伴说 · 学习总结</text>
          <text class="entry-desc">完整回顾你的学习旅程</text>
        </view>
        <text class="entry-arrow">›</text>
      </view>
    </view>

    <view class="bottom-space"></view>
  </view>

  <view wx:else class="loading-state">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>
</view>
