/* ============================================================
   数学小伴 — 总结页
   统一使用 app.wxss 主题变量
   ============================================================ */

.summary-page {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--bg-primary) 0%, var(--bg-card) 30%);
}

.header {
  position: relative;
  padding-top: 60rpx;
  padding-bottom: 40rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 320rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  border-radius: 0 0 48rpx 48rpx;
}

.header-content {
  position: relative;
  z-index: 1;
  padding: 0 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.title-row {
  display: flex;
  flex-direction: column;
}

.header-refresh-btn {
  background: rgba(255, 255, 255, 0.25);
  color: var(--text-on-primary);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 40rpx;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.header-refresh-btn::after {
  border: none;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-on-primary);
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
}

.update-time {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.content {
  padding: 0 24rpx;
  margin-top: -40rpx;
  position: relative;
  z-index: 2;
}

/* ============================================================
   空状态
   ============================================================ */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 48rpx;
}

.start-btn {
  background: linear-gradient(135deg, var(--primary-dark) 0%, #FF5CA8 100%);
  color: var(--text-on-primary);
  border: none;
  border-radius: 50rpx;
  padding: 24rpx 80rpx;
  font-size: 32rpx;
  font-weight: 600;
}

/* ============================================================
   范围切换 Tabs
   ============================================================ */
.scope-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 4rpx;
  background: var(--bg-card);
  border-radius: 48rpx;
  box-shadow: 0 4rpx 20rpx var(--shadow-sm);
}

.scope-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 20rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  transition: all 0.3s ease;
}

.scope-tab.active {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: var(--text-on-primary);
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx var(--shadow);
}

/* ============================================================
   统计网格
   ============================================================ */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.stat-card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 24rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 20rpx var(--shadow-sm);
  animation: fadeInUp 0.4s ease both;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--primary-dark);
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* ============================================================
   内容卡片
   ============================================================ */
.progress-section, .suggestions-section, .summary-card {
  background: var(--bg-card);
  border-radius: var(--radius-xl);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx var(--shadow-sm);
  animation: fadeInUp 0.4s ease both;
}

.progress-section {
  animation-delay: 0.05s;
}

.suggestions-section {
  animation-delay: 0.1s;
}

.summary-card {
  animation-delay: 0.15s;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

.section-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-arrow {
  font-size: 24rpx;
  color: var(--text-secondary);
  transition: transform 0.3s ease;
}

.toggle-text {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* ============================================================
   知识点进度条
   ============================================================ */
.grade-group {
  margin-bottom: 32rpx;
}

.grade-group:last-child {
  margin-bottom: 0;
}

.grade-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary-dark);
  margin-bottom: 16rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid var(--primary);
}

.progress-item {
  margin-bottom: 24rpx;
  padding-left: 16rpx;
  animation: fadeInUp 0.4s ease both;
}

.progress-item:last-child {
  margin-bottom: 0;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.progress-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.progress-level {
  font-size: 24rpx;
  color: var(--primary-dark);
  background: rgba(255, 126, 179, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.progress-bar-bg {
  height: 16rpx;
  background: var(--bg-input);
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary) 0%, var(--primary-dark) 100%);
  border-radius: 8rpx;
  transition: width 0.5s ease;
}

.progress-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 10rpx;
}

.progress-count {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.progress-rate {
  font-size: 24rpx;
  color: var(--primary-dark);
  font-weight: 500;
}

/* ============================================================
   学习建议
   ============================================================ */
.suggestions-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.suggestion-item {
  background: linear-gradient(135deg, var(--bg-primary) 0%, var(--primary-light) 100%);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: var(--primary-dark);
  line-height: 1.6;
}

/* ============================================================
   总结内容
   ============================================================ */
.summary-content {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.8;
  white-space: pre-line;
}

/* ============================================================
   模块入口卡片
   ============================================================ */
.entry-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 8rpx;
}

.entry-card {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border-radius: var(--radius-xl);
  padding: 28rpx 32rpx;
  box-shadow: 0 4rpx 20rpx var(--shadow-sm);
  animation: fadeInUp 0.4s ease both;
  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.entry-card:nth-child(1) { animation-delay: 0.05s; }
.entry-card:nth-child(2) { animation-delay: 0.1s; }
.entry-card:nth-child(3) { animation-delay: 0.15s; }

.entry-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-lg);
  background: linear-gradient(135deg, var(--bg-primary) 0%, var(--primary-light) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.entry-icon text {
  font-size: 44rpx;
}

.entry-info {
  flex: 1;
  min-width: 0;
}

.entry-title {
  display: block;
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.entry-desc {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-secondary);
  line-height: 1.5;
}

.entry-arrow {
  font-size: 44rpx;
  color: var(--text-tertiary);
  margin-left: 16rpx;
}

/* ============================================================
   缓存提示
   ============================================================ */
.cache-hint {
  background: linear-gradient(135deg, #FFF3E0 0%, #FFE0B2 100%);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}

.cache-hint-text {
  font-size: 24rpx;
  color: #E65100;
  line-height: 1.5;
  flex: 1;
}

.refresh-btn {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: var(--text-on-primary);
  border: none;
  border-radius: 32rpx;
  padding: 12rpx 28rpx;
  font-size: 24rpx;
  font-weight: 600;
  margin-left: 16rpx;
  flex-shrink: 0;
  line-height: 1.4;
}

.refresh-btn::after {
  border: none;
}

.bottom-space {
  height: 120rpx;
}

/* ============================================================
   加载状态
   ============================================================ */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 40rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--primary);
  border-top-color: var(--primary-dark);
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}
