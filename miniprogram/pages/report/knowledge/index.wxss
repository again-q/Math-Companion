/* ============================================================
   知识点地图页
   ============================================================ */

.report-page {
  min-height: 100vh;
  background: var(--bg-primary);
  padding: var(--space-2xl);
  box-sizing: border-box;
}

.report-header {
  margin-bottom: var(--space-2xl);
}

.report-header-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.report-header-sub {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

/* ============================================================
   推荐学习条
   ============================================================ */
.recommend-bar {
  display: flex;
  align-items: center;
  gap: var(--space);
  background: linear-gradient(135deg, rgba(255,126,179,0.12) 0%, rgba(255,181,194,0.18) 100%);
  border: 2rpx solid rgba(255,126,179,0.25);
  border-radius: var(--radius-lg);
  padding: var(--space) var(--space-lg);
  margin-bottom: var(--space-xl);
  animation: fadeInUp 0.35s ease both;
}

.recommend-icon {
  font-size: 34rpx;
}

.recommend-text {
  font-size: var(--font-sm);
  color: var(--primary-dark);
  font-weight: 600;
}

/* ============================================================
   单元分组
   ============================================================ */
.map-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-xl);
}

.grade-group {
  animation: fadeInUp 0.35s ease both;
}

.grade-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space);
  padding: 0 4rpx;
}

.grade-name {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--primary-dark);
}

.grade-right {
  display: flex;
  align-items: center;
  gap: var(--space);
}

/* 单元状态标签 */
.unit-status {
  font-size: var(--font-xs);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-full);
}

.unit-status.none {
  background: var(--bg-input);
  color: var(--text-tertiary);
}

.unit-status.mid {
  background: rgba(255,149,0,0.15);
  color: #B26A00;
}

.unit-status.good {
  background: rgba(52,199,89,0.15);
  color: #2E7D32;
}

/* 单元测试按钮 */
.unit-test-btn {
  padding: 8rpx 20rpx;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.unit-test-btn:active {
  transform: scale(0.95);
  opacity: 0.85;
}

.unit-test-text {
  font-size: var(--font-xs);
  color: var(--text-on-primary);
  font-weight: 600;
}

.grade-count {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
}

/* ============================================================
   知识点行
   ============================================================ */
.topic-row {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: var(--space) var(--space-lg);
  margin-bottom: var(--space);
  box-shadow: 0 2rpx 12rpx var(--shadow-sm);
}

.topic-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.topic-name-wrap {
  display: flex;
  align-items: center;
  gap: var(--space);
  flex: 1;
  min-width: 0;
}

.topic-name {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.topic-level {
  font-size: var(--font-xs);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-full);
  flex-shrink: 0;
}

.topic-level.none {
  background: var(--bg-input);
  color: var(--text-tertiary);
}

.topic-level.start {
  background: rgba(255,59,48,0.1);
  color: #C62828;
}

.topic-level.mid {
  background: rgba(255,149,0,0.15);
  color: #B26A00;
}

.topic-level.good {
  background: rgba(52,199,89,0.15);
  color: #2E7D32;
}

/* 开始学习按钮 */
.topic-start {
  flex-shrink: 0;
  margin-left: var(--space);
  padding: 10rpx 24rpx;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.topic-start:active {
  transform: scale(0.95);
  opacity: 0.85;
}

.topic-start-text {
  font-size: var(--font-xs);
  color: var(--text-on-primary);
  font-weight: 600;
}

/* 进度条 */
.topic-progress-row {
  display: flex;
  align-items: center;
  gap: var(--space);
  margin-top: var(--space-sm);
}

.topic-progress-bg {
  flex: 1;
  height: 10rpx;
  background: var(--bg-input);
  border-radius: 5rpx;
  overflow: hidden;
}

.topic-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary) 0%, var(--primary-dark) 100%);
  border-radius: 5rpx;
  transition: width 0.4s ease;
}

.topic-percent {
  font-size: var(--font-xs);
  color: var(--text-secondary);
  width: 60rpx;
  text-align: right;
  flex-shrink: 0;
}

/* 元信息 + AI 点评 */
.topic-meta {
  display: flex;
  gap: var(--space-lg);
  margin-top: var(--space-xs);
}

.topic-meta-item {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
}

.topic-comment {
  margin-top: var(--space-sm);
  padding: var(--space) var(--space-sm);
  background: var(--bg-input);
  border-radius: var(--radius-sm);
}

.topic-comment-text {
  font-size: var(--font-xs);
  color: var(--text-secondary);
  line-height: 1.6;
}

/* 加载 / 空状态 */
.loading-state,
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 40rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--primary);
  border-top-color: var(--primary-dark);
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: var(--font-md);
  color: var(--text-secondary);
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: var(--space-lg);
}

.empty-text {
  font-size: var(--font-md);
  color: var(--text-secondary);
}

.empty-btn {
  margin-top: var(--space-xl);
  padding: 16rpx 48rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  border-radius: var(--radius-full);
  font-size: var(--font-md);
  color: var(--text-on-primary);
}

.bottom-space {
  height: 120rpx;
}
