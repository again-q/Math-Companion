<view class="report-page">
  <view class="report-header">
    <text class="report-header-title">📚 知识点地图</text>
    <text class="report-header-sub">初一到初三全部知识点 · 点「开始学习」逐个攻克</text>
  </view>

  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <block wx:elif="{{!empty}}">
    <!-- 推荐条与列表是独立条件，同时显示（不能用 wx:else 互斥链） -->
    <view class="recommend-bar" wx:if="{{recommendTopic}}">
      <text class="recommend-icon">🎯</text>
      <text class="recommend-text">建议先学：{{recommendTopic}}</text>
    </view>

    <view class="map-list">
      <view class="grade-group" wx:for="{{groups}}" wx:key="grade" wx:for-item="group">
      <view class="grade-header">
        <text class="grade-name">{{group.grade}}</text>
        <view class="grade-right">
          <text class="unit-status {{group.unitClass}}">{{group.unitStatus}}</text>
          <text class="grade-count">{{group.practicedCount}}/{{group.topics.length}} 已学</text>
        </view>
      </view>

      <view class="topic-row" wx:for="{{group.topics}}" wx:key="topic" wx:for-item="item">
        <view class="topic-top">
          <view class="topic-name-wrap">
            <text class="topic-name">{{item.topic}}</text>
            <text class="topic-level {{item.levelClass}}">{{item.levelDesc}}</text>
          </view>
          <view class="topic-start" hover-class="btn-hover" bindtap="onTopicMain" data-topic="{{item.topic}}" data-level="{{item.level}}">
            <text class="topic-start-text">{{item.level > 0 ? '继续学习' : '开始测试'}}</text>
          </view>
        </view>

        <view class="topic-progress-row">
          <view class="topic-progress-bg">
            <view class="topic-progress-fill" style="width: {{item.percent}}%;"></view>
          </view>
          <text class="topic-percent">{{item.percent}}%</text>
        </view>

        <view class="topic-meta" wx:if="{{item.practicedCount > 0}}">
          <text class="topic-meta-item">练习 {{item.practicedCount}} 次</text>
          <text class="topic-meta-item">连续答对 {{item.consecutiveCorrect}} 次</text>
        </view>

        <view class="topic-comment" wx:if="{{item.comment}}">
          <text class="topic-comment-text">{{item.comment}}</text>
        </view>
      </view>
    </view>

    <view class="bottom-space"></view>
    </view>
  </block>

  <view class="empty-state" wx:else>
    <text class="empty-icon">📭</text>
    <text class="empty-text">还没有学习记录，先去聊一聊吧</text>
    <view class="empty-btn" bindtap="retry">重新加载</view>
  </view>
</view>
