/* ============================================================
   登录 / 开始使用页
   ============================================================ */

.login-page {
  min-height: 100vh;
  background: linear-gradient(160deg, #FFD6E0 0%, var(--bg-primary) 45%, #FFF 100%);
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  overflow: hidden;
}

/* ============================================================
   背景装饰
   ============================================================ */
.login-deco {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 500rpx;
  overflow: hidden;
  pointer-events: none;
}

.deco-circle {
  position: absolute;
  border-radius: 50%;
  background: var(--primary);
  opacity: 0.18;
}

.deco-circle-1 {
  width: 260rpx;
  height: 260rpx;
  top: 60rpx;
  left: -60rpx;
  animation: float 5s ease-in-out infinite;
}

.deco-circle-2 {
  width: 200rpx;
  height: 200rpx;
  top: 160rpx;
  right: -40rpx;
  animation: float 6s ease-in-out infinite;
  animation-delay: 1s;
}

.deco-circle-3 {
  width: 140rpx;
  height: 140rpx;
  top: 320rpx;
  left: 22%;
  animation: float 7s ease-in-out infinite;
  animation-delay: 2s;
}

/* ============================================================
   主视觉
   ============================================================ */
.login-main {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: calc(env(safe-area-inset-top) + 160rpx);
  animation: fadeInUp 0.6s ease both;
}

.login-avatar {
  position: relative;
  width: 220rpx;
  height: 220rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 48rpx;
  box-shadow: 0 20rpx 60rpx var(--shadow-lg);
  animation: bounce 2.5s ease-in-out infinite;
}

.avatar-emoji {
  font-size: 110rpx;
}

.avatar-glow {
  position: absolute;
  top: -10rpx;
  left: -10rpx;
  right: -10rpx;
  bottom: -10rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  opacity: 0.35;
  filter: blur(24rpx);
  z-index: -1;
}

.login-title {
  font-size: 64rpx;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
}

.login-subtitle {
  font-size: 32rpx;
  color: var(--primary-dark);
  font-weight: 600;
  margin-bottom: 48rpx;
}

.login-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.login-desc-sub {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

/* ============================================================
   底部操作
   ============================================================ */
.login-bottom {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 0 60rpx calc(env(safe-area-inset-bottom) + 60rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: fadeInUp 0.6s ease both;
  animation-delay: 0.2s;
}

.btn-start {
  width: 100%;
  height: 100rpx;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, var(--primary-dark) 0%, #FF5CA8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 12rpx 40rpx var(--shadow);
  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.2s ease;
}

.btn-start:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.btn-start-icon {
  font-size: 36rpx;
}

.btn-start-label {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-on-primary);
}

.login-version {
  margin-top: 28rpx;
  font-size: 22rpx;
  color: var(--text-tertiary);
}

/* ============================================================
   动画
   ============================================================ */
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-24rpx); }
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-16rpx); }
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}
